# =========================================================
# BTC Sentiment-Driven LSTM Trading Pipeline — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# =========================================================

# ---- Streamlit ----
# No secrets needed for read-only dashboard. The app reads from
# outputs/ and Data/ which are committed to the repo.

# ---- Sentiment Alert System (optional) ----
# Configure ONE of the following notification channels. If none are
# set, the alert system logs to audit/sentiment_alerts.csv but sends
# no notifications. The cron job runs daily at 08:00 UTC.

# Email (SMTP) — all four vars required for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Slack (incoming webhook)
SLACK_WEBHOOK_URL=

# Discord (incoming webhook)
DISCORD_WEBHOOK_URL=

# ---- HuggingFace cache (optional) ----
# If you run FinBERT inference locally, set this to a persistent dir
# so model downloads survive container restarts.
# HF_HOME=/app/.cache/huggingface

# ---- TensorFlow (optional) ----
# Suppress TF info-level logs (keeps Streamlit Cloud logs readable)
TF_CPP_MIN_LOG_LEVEL=3

# ---- Streamlit Cloud secrets ----
# If deploying to Streamlit Cloud, add secrets via the web UI instead
# of committing them here.
